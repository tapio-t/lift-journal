# Copy to keystore.properties (git-ignored) to sign release builds. Never commit the real file or the keystore.
# Create a keystore with: keytool -genkeypair -v -keystore lift-journal-release.jks -keyalg RSA -keysize 4096 -validity 10000 -alias liftjournal
storeFile=lift-journal-release.jks
storePassword=change-me
keyAlias=liftjournal
keyPassword=change-me
